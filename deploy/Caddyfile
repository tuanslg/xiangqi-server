# API host only (the website itself is served by Cloudflare Pages, which sets its own security headers).
{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}

	# WebSocket upgrades (/ws) are proxied automatically.
	reverse_proxy api:3001
}
