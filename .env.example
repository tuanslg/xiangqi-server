# Copy to .env on the server (never commit .env).

# Host name of the API, pointing at the VPS. Caddy gets a Let's Encrypt certificate for it automatically.
API_DOMAIN=api.example.com

# Origin of the website on Cloudflare Pages. MUST share the registrable domain with API_DOMAIN
# (app.example.com + api.example.com), otherwise login/guest cookies are blocked as cross-site.
APP_ORIGIN=https://app.example.com

# Use hex only so it is safe inside the DATABASE_URL:  openssl rand -hex 24
POSTGRES_PASSWORD=

# OAuth client id from Google Cloud Console (see DEPLOY.md). Leave empty to hide the login button.
GOOGLE_CLIENT_ID=

# Pikafish processes and their settings. Rule of thumb: ENGINE_POOL_SIZE * ENGINE_THREADS <= vCPUs.
ENGINE_POOL_SIZE=2
ENGINE_THREADS=1
ENGINE_HASH_MB=32
